<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================ -->
    <!-- Default /store-locator page: a normal Website page built     -->
    <!-- from the Store Locator blocks. Edit it with Website > Edit.  -->
    <!-- noupdate: module upgrades never overwrite your page edits.   -->
    <!-- ============================================================ -->
    <data noupdate="1">
        <record id="store_locator_page_view" model="ir.ui.view">
            <field name="name">Store Locator</field>
            <field name="type">qweb</field>
            <field name="key">store_locator.store_locator_page_view</field>
            <field name="arch" type="xml">
                <t name="Store Locator" t-name="store_locator.store_locator_page_view">
                    <t t-call="website.layout">
                        <t t-set="additional_title">Store Locator</t>
                        <div id="wrap" class="oe_structure oe_empty">
                            <section data-snippet="s_store_locator_hero" data-name="Store Locator Hero" class="s_store_locator_hero o_colored_level pt64 pb80" style="background-image: linear-gradient(120deg, rgb(15, 44, 107) 0%, rgb(37, 99, 235) 55%, rgb(59, 130, 246) 100%);"><div class="container"><div class="row"><div class="col-lg-8 offset-lg-2 text-center"><h1 class="display-5 text-white">Store Locator</h1><p class="lead text-white mb-0">Find your nearest store: addresses, opening hours and directions.</p></div></div></div></section>
                            <section class="s_store_finder s_store_locator_overlap o_colored_level pt0 pb48" data-snippet="s_store_finder" data-name="Store Locator"><div class="container"><div class="sl-finder-top sl-dropzone"><div class="s_sl_filter_panel sl-block sl-fpanel sl-fpanel-bar sl-fpanel-h sl-fpanel-notitle" data-snippet="s_sl_filter_panel" data-name="Filter Panel"><div class="sl-fpanel-head"><span class="sl-fpanel-title"><i class="fa fa-sliders"/> Filters</span><span class="sl-fpanel-chev fa fa-chevron-down o_not_editable" contenteditable="false"/></div><div class="sl-fpanel-body sl-dropzone"><div class="s_sl_search sl-block" data-snippet="s_sl_search" data-name="Store Search"><div class="sl-rt o_not_editable" contenteditable="false" data-oe-protected="true"><div class="sl-skel sl-skel-search"><span class="fa fa-search"/> Search by name, city, street or ZIP...</div></div></div></div></div></div><div class="row g-4"><div class="col-lg-4 sl-dropzone"><div class="s_sl_filter_panel sl-block sl-fpanel sl-fpanel-v sl-fpanel-grid2 sl-fpanel-collapsible" data-snippet="s_sl_filter_panel" data-name="Filter Panel"><div class="sl-fpanel-head"><span class="sl-fpanel-title"><i class="fa fa-sliders"/> Filters</span><span class="sl-fpanel-chev fa fa-chevron-down o_not_editable" contenteditable="false"/></div><div class="sl-fpanel-body sl-dropzone"><div class="s_sl_filter sl-block" data-snippet="s_sl_filter" data-name="Store Filter" data-filter="category" data-display="chips"><div class="sl-filter-label">Categories</div><div class="sl-rt o_not_editable" contenteditable="false" data-oe-protected="true"><div class="sl-skel sl-skel-control"/></div></div><div class="s_sl_filter sl-block" data-snippet="s_sl_filter" data-name="Store Filter" data-filter="country"><div class="sl-filter-label">Country</div><div class="sl-rt o_not_editable" contenteditable="false" data-oe-protected="true"><div class="sl-skel sl-skel-control"/></div></div><div class="s_sl_filter sl-block" data-snippet="s_sl_filter" data-name="Store Filter" data-filter="state"><div class="sl-filter-label">State / Province</div><div class="sl-rt o_not_editable" contenteditable="false" data-oe-protected="true"><div class="sl-skel sl-skel-control"/></div></div><div class="s_sl_filter sl-block" data-snippet="s_sl_filter" data-name="Store Filter" data-filter="zip"><div class="sl-filter-label">ZIP code</div><div class="sl-rt o_not_editable" contenteditable="false" data-oe-protected="true"><div class="sl-skel sl-skel-control"/></div></div><div class="s_sl_filter sl-block" data-snippet="s_sl_filter" data-name="Store Filter" data-filter="radius"><div class="sl-filter-label">Distance from me</div><div class="sl-rt o_not_editable" contenteditable="false" data-oe-protected="true"><div class="sl-skel sl-skel-control"/></div></div><div class="s_sl_filter sl-block sl-filter-inline" data-snippet="s_sl_filter" data-name="Store Filter" data-filter="featured" data-display="switch"><div class="sl-filter-label">Featured stores only</div><div class="sl-rt o_not_editable" contenteditable="false" data-oe-protected="true"><div class="sl-skel sl-skel-control"/></div></div><div class="s_sl_filter sl-block sl-filter-nolabel" data-snippet="s_sl_filter" data-name="Store Filter" data-filter="clear"><div class="sl-filter-label">Filter</div><div class="sl-rt o_not_editable" contenteditable="false" data-oe-protected="true"><div class="sl-skel sl-skel-control"/></div></div></div></div><div class="s_sl_list sl-block sl-cols-1" data-snippet="s_sl_list" data-name="Store List" data-layout="list"><div class="sl-card-tpl" data-card-click="select"><article class="sl-tcard sl-tcard-h"><div class="sl-tcard-media" data-sl-card="image"><img class="sl-tcard-img" src="/store_locator/static/src/img/store_placeholder.svg" alt=""/><span class="sl-tcard-ph"><i class="fa fa-building-o"/></span><span class="sl-tcard-flag" data-sl-card="featured_flag"><i class="fa fa-star"/></span></div><div class="sl-tcard-body"><h3 class="sl-tcard-name" data-sl-card="name">Store name</h3><p class="sl-tcard-cat" data-sl-card="category"><i class="fa fa-tag"/> <span data-sl-text="">Category</span></p><p class="sl-tcard-addr" data-sl-card="address"><i class="fa fa-map-marker"/> <span data-sl-text="">Street, ZIP City, Country</span></p><p class="sl-tcard-dist" data-sl-card="distance"><i class="fa fa-road"/> <span data-sl-text="">1.2 km</span> away</p><div class="sl-tcard-tags" data-sl-card="tags"><span class="sl-tcard-tag" data-sl-tag="">Tag</span></div><div class="sl-tcard-actions"><a class="btn btn-primary btn-sm sl-tcard-btn" data-sl-link="detail" href="#">View Details <i class="fa fa-arrow-right"/></a><a class="sl-tcard-icon" data-sl-link="directions" href="#" title="Directions"><i class="fa fa-location-arrow"/></a><a class="sl-tcard-icon" data-sl-link="phone" href="#" title="Call"><i class="fa fa-phone"/></a><a class="sl-tcard-icon" data-sl-link="website" href="#" title="Website"><i class="fa fa-globe"/></a></div></div></article></div><div class="sl-rt o_not_editable" contenteditable="false" data-oe-protected="true"><div class="sl-skel-list"><div class="sl-skel sl-skel-card"><span class="sl-skel-thumb"/><span class="sl-skel-lines"><span/><span/><span/></span></div><div class="sl-skel sl-skel-card"><span class="sl-skel-thumb"/><span class="sl-skel-lines"><span/><span/><span/></span></div><div class="sl-skel sl-skel-card"><span class="sl-skel-thumb"/><span class="sl-skel-lines"><span/><span/><span/></span></div></div></div></div></div><div class="col-lg-8 sl-dropzone"><div class="s_sl_map sl-block" data-snippet="s_sl_map" data-name="Store Map" data-marker-style="pin" data-marker-size="medium" data-tiles="osm" data-popup-image="true" data-popup-category="true" data-popup-name="true" data-popup-address="true" data-popup-detail="true" data-popup-directions="true" data-sticky="true"><div class="sl-rt o_not_editable" contenteditable="false" data-oe-protected="true"><div class="sl-skel sl-skel-map"><span class="sl-skel-pin" style="left: 28%; top: 38%;"/><span class="sl-skel-pin" style="left: 52%; top: 30%;"/><span class="sl-skel-pin" style="left: 64%; top: 55%;"/><span class="sl-skel-pin" style="left: 40%; top: 62%;"/><span class="sl-skel-caption"><span class="fa fa-map-marker"/> Store map</span></div></div></div></div></div></div></section>
                        </div>
                    </t>
                </t>
            </field>
        </record>

        <record id="store_locator_website_page" model="website.page">
            <field name="url">/store-locator</field>
            <field name="is_published">True</field>
            <field name="view_id" ref="store_locator_page_view"/>
            <field name="track">True</field>
            <field name="website_meta_title">Store Locator</field>
            <field name="website_meta_description">Find your nearest store: addresses, opening hours, phone numbers, directions and an interactive map.</field>
        </record>
    </data>
</odoo>
