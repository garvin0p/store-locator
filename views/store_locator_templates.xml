<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ================================================================ -->
    <!-- Store detail page (controller: /store-locator/store/<slug>)      -->
    <!--                                                                  -->
    <!-- The page is 100% building blocks: Website > Edit to move, add,   -->
    <!-- remove and style them. The layout zones are shared by every      -->
    <!-- store page; each block shows the data of the store being viewed  -->
    <!-- (data-sl-* markers filled by controllers/store_fields.py).       -->
    <!-- The "this store only" zone (website_content field) is per store. -->
    <!-- ================================================================ -->
    <template id="store_locator_store_page" name="Store Details">
        <t t-call="website.layout">
            <t t-set="additional_title" t-value="store.name"/>
            <t t-set="seo_object" t-value="store"/>
            <t t-set="website_meta_description" t-value="store.website_meta_description or store.short_description or store.name"/>
            <div id="wrap" class="o_store_locator_detail" t-att-style="sl_style" t-att-data-sl-store-id="store.id">
                <div class="sl-unpublished-note container" t-if="not store.is_published">
                    <span class="fa fa-eye-slash" aria-hidden="true"/>
                    This store is not published: only editors can see this page.
                </div>
                <!-- Shared zone kept for pages customized with version 2.0 -->
                <div class="oe_structure oe_empty" id="oe_structure_store_detail_top"/>

                <!-- Main layout (shared by all store pages) -->
                <div class="oe_structure" id="oe_structure_store_detail_layout">
                    <section class="s_sl_page_hero o_colored_level pt48 pb96" data-snippet="s_sl_page_hero" data-name="Store Hero" style="background-image: linear-gradient(120deg, rgb(15, 44, 107) 0%, rgb(37, 99, 235) 55%, rgb(59, 130, 246) 100%);"><div class="container"><nav class="s_sl_breadcrumb sl-block sl-on-dark mb-4" aria-label="breadcrumb" data-snippet="s_sl_breadcrumb" data-name="Store Breadcrumb"><div class="o_not_editable" data-sl-value="breadcrumb"><ol class="breadcrumb sl-breadcrumb mb-0"><li class="breadcrumb-item"><a href="/store-locator">Store Locator</a></li><li class="breadcrumb-item active">Store Name</li></ol></div></nav><div class="row align-items-center g-4"><div class="col-lg-auto"><div class="s_sl_image sl-block sl-img-avatar sl-img-ring" data-snippet="s_sl_image" data-name="Store Image" data-sl-if="image"><img class="sl-img" data-sl-src="image" src="/store_locator/static/src/img/store_placeholder.svg" alt="Store"/></div></div><div class="col-lg"><div class="s_sl_title sl-block" data-snippet="s_sl_title" data-name="Store Title"><h1 class="sl-title o_not_editable text-white mb-2" data-sl-value="name">Store Name</h1></div><div class="s_sl_badges sl-block sl-badges-glass" data-snippet="s_sl_badges" data-name="Store Badges"><div class="o_not_editable" data-sl-value="badges"><span class="sl-v-badges"><span class="sl-badge sl-badge-cat">Category</span><span class="sl-badge sl-badge-feat"><span class="fa fa-star"/> Featured</span><span class="sl-badge sl-badge-tag">Tag</span></span></div></div><div class="s_sl_text sl-block" data-snippet="s_sl_text" data-name="Store Text" data-sl-if="short_description"><p class="sl-text o_not_editable text-white mt-2 mb-0" data-sl-value="short_description">Short description of the store.</p></div></div><div class="col-lg-auto"><div class="s_sl_buttons sl-block " data-snippet="s_sl_buttons" data-name="Store Buttons"><a class="btn btn-light" data-sl-href="directions" href="#"><i class="fa fa-location-arrow"/> Get Directions</a><a class="btn btn-outline-light" data-sl-href="phone" data-sl-if="phone" href="#"><i class="fa fa-phone"/> Call</a><a class="btn btn-outline-light" data-sl-href="website" data-sl-if="website" href="#"><i class="fa fa-globe"/> Website</a></div></div></div></div></section>
                    <section class="s_sl_page_section sl-overlap-prev o_colored_level pt0 pb24" data-snippet="s_sl_page_gallery" data-name="Store Gallery Section" data-sl-if="gallery"><div class="container"><div class="s_card card o_cc o_cc1 sl-panel-card " data-snippet="s_card" data-name="Card"><div class="card-body"><h2 class="sl-panel-h"><i class="fa fa-picture-o sl-icon-primary"/> Photo Gallery</h2><div class="s_sl_gallery sl-block" data-snippet="s_sl_gallery" data-name="Store Gallery" data-layout="slider" data-sl-if="gallery"><div class="o_not_editable" data-sl-value="gallery"><div class="sl-gal"><div class="sl-gal-stage"><figure class="sl-gal-slide is-active"><img src="/store_locator/static/src/img/gallery_1.svg" alt=""/></figure><figure class="sl-gal-slide"><img src="/store_locator/static/src/img/gallery_2.svg" alt=""/></figure><figure class="sl-gal-slide"><img src="/store_locator/static/src/img/gallery_3.svg" alt=""/></figure></div><div class="sl-gal-thumbs"><button type="button" class="sl-gal-thumb is-active"><img src="/store_locator/static/src/img/gallery_1.svg" alt=""/></button><button type="button" class="sl-gal-thumb"><img src="/store_locator/static/src/img/gallery_2.svg" alt=""/></button><button type="button" class="sl-gal-thumb"><img src="/store_locator/static/src/img/gallery_3.svg" alt=""/></button></div></div></div></div></div></div></div></section>
                    <section class="s_sl_page_section o_colored_level pt0 pb24" data-snippet="s_sl_page_info" data-name="Store Info Cards"><div class="container"><div class="row g-4"><div class="col-lg-4"><div class="s_card card o_cc o_cc1 sl-panel-card h-100" data-snippet="s_card" data-name="Card"><div class="card-body"><h2 class="sl-panel-h"><i class="fa fa-map-marker sl-icon-primary"/> Address</h2><div class="s_sl_address sl-block sl-address-icon" data-snippet="s_sl_address" data-name="Store Address"><div class="o_not_editable" data-sl-value="address"><span class="sl-v-address"><span class="sl-v-line">Street</span><span class="sl-v-line">ZIP City</span><span class="sl-v-line">Country</span></span></div></div><div class="s_sl_buttons sl-block mt-2" data-snippet="s_sl_buttons" data-name="Store Buttons"><a class="btn btn-link px-0" data-sl-href="maps" href="#"><i class="fa fa-external-link"/> Open in Google Maps</a></div></div></div></div><div class="col-lg-4"><div class="s_card card o_cc o_cc1 sl-panel-card h-100" data-snippet="s_card" data-name="Card"><div class="card-body"><h2 class="sl-panel-h"><i class="fa fa-clock-o sl-icon-primary"/> Opening Hours</h2><div class="s_sl_hours sl-block " data-snippet="s_sl_hours" data-name="Store Hours"><div class="o_not_editable" data-sl-value="hours"><div class="sl-v-hours"><table class="sl-hours"><tbody><tr class="sl-hours-row"><th>Monday</th><td>9:00 - 18:00</td></tr><tr class="sl-hours-row"><th>Tuesday</th><td>9:00 - 18:00</td></tr><tr class="sl-hours-row"><th>Wednesday</th><td>9:00 - 18:00</td></tr></tbody></table></div></div></div></div></div></div><div class="col-lg-4"><div class="s_card card o_cc o_cc1 sl-panel-card h-100" data-snippet="s_card" data-name="Card"><div class="card-body"><h2 class="sl-panel-h"><i class="fa fa-phone sl-icon-primary"/> Contact</h2><div class="s_sl_contact sl-block " data-snippet="s_sl_contact" data-name="Store Contact"><div class="o_not_editable" data-sl-value="contact"><ul class="sl-contact"><li class="sl-contact-phone"><span class="fa fa-phone"/> <a href="#">+1 555-0100</a></li><li class="sl-contact-email"><span class="fa fa-envelope"/> <a href="#">store@example.com</a></li></ul></div></div></div></div></div></div></div></section>
                    <section class="s_sl_page_section o_colored_level pt0 pb24" data-snippet="s_sl_page_about" data-name="Store About Section" data-sl-if="description"><div class="container"><div class="s_card card o_cc o_cc1 sl-panel-card " data-snippet="s_card" data-name="Card"><div class="card-body"><h2 class="sl-panel-h"><i class="fa fa-align-left sl-icon-primary"/> About this store</h2><div class="s_sl_about sl-block " data-snippet="s_sl_about" data-name="Store About" data-sl-if="description"><div class="o_not_editable" data-sl-value="description"><p>The store description (Store Locator app, Description tab) appears here.</p></div></div></div></div></div></section>
                </div>

                <!-- This store only -->
                <t t-set="store_editor_message">DRAG BUILDING BLOCKS HERE (THIS STORE ONLY)</t>
                <div t-field="store.website_content"
                     t-att-data-editor-message="store_editor_message"
                     class="oe_structure oe_empty sl-detail-content"/>

                <!-- Second layout zone (shared by all store pages) -->
                <div class="oe_structure" id="oe_structure_store_detail_layout_bottom">
                    <section class="s_sl_page_section o_colored_level pt0 pb24" data-snippet="s_sl_page_map" data-name="Store Map Section" data-sl-if="map"><div class="container"><div class="s_card card o_cc o_cc1 sl-panel-card sl-panel-flush" data-snippet="s_card" data-name="Card"><div class="s_sl_location_map sl-block" data-snippet="s_sl_location_map" data-name="Store Location Map" data-sl-geo="" data-sl-if="map" data-marker-style="pin" data-marker-size="large" data-tiles="osm" data-zoom="15"><div class="sl-lmap-canvas o_not_editable" contenteditable="false" data-oe-protected="true"><div class="sl-skel sl-skel-map"><span class="sl-skel-pin" style="left: 50%; top: 45%;"/></div></div></div><div class="card-body d-flex flex-wrap align-items-center justify-content-between gap-3"><div class="s_sl_text sl-block" data-snippet="s_sl_text" data-name="Store Text" data-sl-if="address_line"><p class="sl-text o_not_editable text-muted mb-0" data-sl-value="address_line">Street, ZIP City, Country</p></div><div class="s_sl_buttons sl-block " data-snippet="s_sl_buttons" data-name="Store Buttons"><a class="btn btn-primary" data-sl-href="directions" href="#"><i class="fa fa-location-arrow"/> Get Directions</a></div></div></div></div></section>
                    <section class="s_sl_related o_colored_level pt24 pb48" data-snippet="s_sl_related" data-name="Related Stores" data-relation="nearby" data-limit="3"><div class="container"><h2 class="h4 mb-3"><i class="fa fa-map-signs sl-icon-primary"/> Nearby stores</h2><div class="sl-card-tpl" data-card-click="detail"><article class="sl-tcard sl-tcard-v"><div class="sl-tcard-media" data-sl-card="image"><img class="sl-tcard-img" src="/store_locator/static/src/img/store_placeholder.svg" alt=""/><span class="sl-tcard-ph"><i class="fa fa-building-o"/></span><span class="sl-tcard-flag" data-sl-card="featured_flag"><i class="fa fa-star"/></span></div><div class="sl-tcard-body"><p class="sl-tcard-cat" data-sl-card="category"><i class="fa fa-tag"/> <span data-sl-text="">Category</span></p><h3 class="sl-tcard-name" data-sl-card="name">Store name</h3><p class="sl-tcard-desc" data-sl-card="description">Short description of the store.</p><p class="sl-tcard-addr" data-sl-card="address"><i class="fa fa-map-marker"/> <span data-sl-text="">Street, ZIP City, Country</span></p><div class="sl-tcard-actions"><a class="sl-tcard-more" data-sl-link="detail" href="#">View details <i class="fa fa-arrow-right"/></a></div></div></article></div><div class="sl-cards-rt o_not_editable sl-cols-3" contenteditable="false" data-oe-protected="true"/><div class="sl-cards-arrows o_not_editable" contenteditable="false"><button type="button" class="sl-cards-prev" aria-label="Previous"><i class="fa fa-chevron-left"/></button><button type="button" class="sl-cards-next" aria-label="Next"><i class="fa fa-chevron-right"/></button></div></div></section>
                    <section class="s_sl_page_section o_colored_level pt0 pb48" data-snippet="s_sl_page_back" data-name="Store Back Button"><div class="container text-center"><div class="s_sl_buttons sl-block justify-content-center" data-snippet="s_sl_buttons" data-name="Store Buttons"><a class="btn btn-outline-secondary rounded-pill" data-sl-href="locator" href="#"><i class="fa fa-arrow-left"/> Back to Store Locator</a></div></div></section>
                </div>

                <!-- Shared zone kept for pages customized with version 2.0 -->
                <div class="oe_structure oe_empty" id="oe_structure_store_detail_bottom"/>
            </div>
        </t>
    </template>
</odoo>
